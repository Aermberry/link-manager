<Window x:Class="LinkMgr.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="linkmgr — 链接管理" Height="480" Width="960">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="已登记链接" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

        <ListView Grid.Row="1" x:Name="EntriesList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="源路径" Width="280" DisplayMemberBinding="{Binding Source}" />
                    <GridViewColumn Header="目标路径" Width="280" DisplayMemberBinding="{Binding Target}" />
                    <GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding Type}" />
                    <GridViewColumn Header="备注" Width="240" DisplayMemberBinding="{Binding Note}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
