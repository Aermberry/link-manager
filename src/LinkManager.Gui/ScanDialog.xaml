<Window x:Class="LinkManager.Gui.ScanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="扫描存量链接 — 发现未登记的 junction / symlink"
        Height="560" Width="820" MinHeight="460" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/app.ico"
        Background="#FAFAFB">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 选择目录 + 深度 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="扫描目录：" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" x:Name="RootInput" VerticalAlignment="Center" />
            <Button Grid.Column="2" x:Name="BrowseButton" Content="浏览…" Margin="8,0,0,0" Padding="10,4" Click="BrowseButton_Click" />
            <TextBlock Grid.Column="3" Text="深度：" VerticalAlignment="Center" Margin="14,0,6,0" />
            <TextBox Grid.Column="4" x:Name="DepthInput" Width="44" VerticalAlignment="Center"
                     ToolTip="0 = 只扫这一层；1 = 连一层子目录；留空 = 不限深度" />
            <Button Grid.Column="5" x:Name="StartButton" Content="开始扫描" Margin="10,0,0,0" Padding="12,4"
                    Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold"
                    Click="StartButton_Click" />
        </Grid>

        <!-- 结果列表 -->
        <ListView Grid.Row="3" x:Name="FoundList" Margin="0,0,0,10"
                  BorderThickness="1" BorderBrush="#E0E0E3" Background="White">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="登记" Width="46">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="链接位置（源）" Width="300" DisplayMemberBinding="{Binding Source}" />
                    <GridViewColumn Header="数据真实位置（目标）" Width="300" DisplayMemberBinding="{Binding Target}" />
                    <GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding Type}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 汇总 + 按钮 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="SummaryText" VerticalAlignment="Center"
                       Foreground="#5D5D63" TextWrapping="Wrap" Text="选择要登记的目录，扫描发现的链接不会重复登记。" />
            <Button Grid.Column="1" x:Name="CloseButton" Content="关闭" Padding="14,5"
                    Margin="0,0,8,0" IsCancel="True" />
            <Button Grid.Column="2" x:Name="ImportButton" Content="登记所选" Padding="14,5"
                    Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold"
                    Click="ImportButton_Click" />
        </Grid>
    </Grid>
</Window>
