<Window x:Class="LinkManager.Gui.MigrationWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="迁移向导 — 把目录搬到其他盘（原位置变成链接）"
        Height="640" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="#FAFAFB"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- Fluent 浅色色板（与 MainWindow 一致） -->
        <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1975C5" />
        <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
        <SolidColorBrush x:Key="DangerBackgroundBrush" Color="#FDF3F2" />
        <SolidColorBrush x:Key="DangerBorderBrush" Color="#F1C5C0" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E0E0E3" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#5D5D63" />

        <!-- 主 / 次 / 危险按钮样式 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1B1B1F" />
            <Setter Property="BorderBrush" Value="#C9C9CF" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 步骤进度指示条：1-5 圆点 + 名称，当前步高亮，危险步（删源/回指）红色标记 -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
            <StackPanel x:Name="StepIndicatorPanel" Orientation="Horizontal" HorizontalAlignment="Center" />
        </Border>

        <!-- 步骤标题 -->
        <TextBlock Grid.Row="1" x:Name="StepTitle" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

        <!-- 步骤内容 -->
        <Grid Grid.Row="2" x:Name="StepHost">
            <Grid.Children>
                <!-- 第 1 步：选择源目录 -->
                <StackPanel x:Name="SourcePanel">
                    <TextBlock Text="第 1 步：请选择你要搬走的文件夹（源目录）。" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock Text="例如 C 盘上的 C:\Users\某用户\AppData\Roaming\某软件。迁移后原位置会自动变成一个链接，软件感觉不到任何变化。" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="SourceInput" Width="480" VerticalAlignment="Center" />
                        <Button x:Name="BrowseSourceButton" Style="{StaticResource SecondaryButton}" Content="浏览…" Margin="8,0,0,0" Padding="10,4" Click="BrowseSourceButton_Click" />
                    </StackPanel>
                    <TextBlock Text="备注（可选，写这个文件夹是什么）：" Margin="0,14,0,4" />
                    <TextBox x:Name="NoteInput" Width="480" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- 第 2 步：选择目标位置 -->
                <StackPanel x:Name="TargetPanel" Visibility="Collapsed">
                    <TextBlock Text="第 2 步：请选择要把文件夹搬去哪里（目标位置）。" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock Text="目标文件夹必须为空或不存在。例如其他盘的 F:\MovedData\某软件。目标所在盘要有足够空间放下源文件夹的全部内容。" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="TargetInput" Width="480" VerticalAlignment="Center" />
                        <Button x:Name="BrowseTargetButton" Style="{StaticResource SecondaryButton}" Content="浏览…" Margin="8,0,0,0" Padding="10,4" Click="BrowseTargetButton_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- 第 3 步：预览 -->
                <StackPanel x:Name="PreviewPanel" Visibility="Collapsed">
                    <TextBlock Text="第 3 步：请核对下面的迁移计划。" Margin="0,0,0,10" />
                    <TextBox x:Name="PreviewBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" MinHeight="240"
                             Background="#FFFFFF" BorderBrush="{StaticResource CardBorderBrush}" />
                    <!-- 危险警示：执行链路含「删除源目录」与「原位置改链接」两个不可逆动作 -->
                    <Border x:Name="DangerBanner" Background="{StaticResource DangerBackgroundBrush}"
                            BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,9" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                       Text="⚠ 执行包含两个不可逆动作：删除源目录本身、把原位置改写成链接（第 4 步执行后无法在本向导内撤销）。请务必核对上方计划里的「源」「目标」路径。" />
                            <TextBlock x:Name="BlockersText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 第 4 步：执行中（危险步） -->
                <StackPanel x:Name="ExecutePanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <Border Background="{StaticResource DangerBackgroundBrush}" BorderBrush="{StaticResource DangerBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                   Text="⚠ 危险步骤：正在删除源目录并把原位置改写成链接，请不要关闭窗口或操作这些文件夹。" />
                    </Border>
                    <ProgressBar x:Name="ExecuteProgress" IsIndeterminate="True" Height="18" Width="360" HorizontalAlignment="Left" />
                    <TextBlock x:Name="ExecuteDetail" Foreground="{StaticResource SubtleTextBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- 第 5 步：结果摘要（成功绿 / 失败红横幅 + 明细） -->
                <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                    <TextBlock Text="第 5 步：迁移结果" Margin="0,0,0,10" />
                    <Border x:Name="ResultBanner" Background="{StaticResource DangerBackgroundBrush}"
                            BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,9" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ResultBannerGlyph" FontWeight="Bold" FontSize="16"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="ResultBannerText" FontWeight="SemiBold" FontSize="13.5"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBox x:Name="ResultBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" MinHeight="200"
                             Background="#FFFFFF" BorderBrush="{StaticResource CardBorderBrush}" />
                </StackPanel>
            </Grid.Children>
        </Grid>

        <!-- 导航按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BackButton" Style="{StaticResource SecondaryButton}" Content="上一步" Margin="0,0,8,0" Click="BackButton_Click" />
            <Button x:Name="NextButton" Style="{StaticResource PrimaryButton}" Content="下一步" Click="NextButton_Click" />
        </StackPanel>
    </Grid>
</Window>
