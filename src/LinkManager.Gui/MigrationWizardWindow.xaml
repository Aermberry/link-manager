<Window x:Class="LinkManager.Gui.MigrationWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="迁移向导 — 把目录搬到其他盘（原位置变成链接）"
        Height="620" Width="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 步骤指示 -->
        <TextBlock Grid.Row="0" x:Name="StepTitle" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

        <!-- 步骤内容 -->
        <Grid Grid.Row="1" x:Name="StepHost">
            <Grid.Children>
                <!-- 第 1 步：选择源目录 -->
                <StackPanel x:Name="SourcePanel">
                    <TextBlock Text="第 1 步：请选择你要搬走的文件夹（源目录）。" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock Text="例如 C 盘上的 C:\Users\你\AppData\Roaming\某软件。迁移后原位置会自动变成一个链接，软件感觉不到任何变化。" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="SourceInput" Width="480" VerticalAlignment="Center" />
                        <Button x:Name="BrowseSourceButton" Content="浏览…" Margin="8,0,0,0" Padding="10,3" Click="BrowseSourceButton_Click" />
                    </StackPanel>
                    <TextBlock Text="备注（可选，写这个文件夹是什么）：" Margin="0,14,0,4" />
                    <TextBox x:Name="NoteInput" Width="480" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- 第 2 步：选择目标位置 -->
                <StackPanel x:Name="TargetPanel" Visibility="Collapsed">
                    <TextBlock Text="第 2 步：请选择要把文件夹搬去哪里（目标位置）。" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock Text="目标文件夹必须为空或不存在。例如其他盘的 F:\MovedData\某软件。目标所在盘要有足够空间放下源文件夹的全部内容。" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="TargetInput" Width="480" VerticalAlignment="Center" />
                        <Button x:Name="BrowseTargetButton" Content="浏览…" Margin="8,0,0,0" Padding="10,3" Click="BrowseTargetButton_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- 第 3 步：预览 -->
                <StackPanel x:Name="PreviewPanel" Visibility="Collapsed">
                    <TextBlock Text="第 3 步：请核对下面的迁移计划。" Margin="0,0,0,10" />
                    <TextBox x:Name="PreviewBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" MinHeight="240" />
                    <TextBlock x:Name="BlockersText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>

                <!-- 第 4 步：执行中 -->
                <StackPanel x:Name="ExecutePanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="第 4 步：正在迁移，请不要关闭窗口或操作这些文件夹…" FontSize="14" Margin="0,0,0,12" />
                    <ProgressBar x:Name="ExecuteProgress" IsIndeterminate="True" Height="18" Width="360" HorizontalAlignment="Left" />
                    <TextBlock x:Name="ExecuteDetail" Foreground="Gray" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- 第 5 步：结果摘要 -->
                <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                    <TextBlock Text="第 5 步：迁移结果" Margin="0,0,0,10" />
                    <TextBox x:Name="ResultBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" MinHeight="200" />
                </StackPanel>
            </Grid.Children>
        </Grid>

        <!-- 导航按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BackButton" Content="上一步" Padding="14,5" Margin="0,0,8,0" Click="BackButton_Click" />
            <Button x:Name="NextButton" Content="下一步" Padding="14,5" Click="NextButton_Click" />
        </StackPanel>
    </Grid>
</Window>
