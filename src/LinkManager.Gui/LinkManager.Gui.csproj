<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LinkManager.Core\LinkManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 向导状态机的测试接缝（内部执行委托）对测试工程可见 -->
    <InternalsVisibleTo Include="LinkManager.Gui.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!--
    临时规避 dotnet/wpf#11842（https://github.com/dotnet/wpf/issues/11842）：
    .NET 11 起 DirectWriteForwarder.dll / System.Printing.dll 变为 IJW 混合模式
    程序集，无法从单文件 bundle 中加载，WPF self-contained single-file 发布
    启动即崩；把三者排除出 bundle、以散文件随 exe 发布可绕过。上游修复后
    应删除本 Target。（不需要 NoWarn NETSDK1244：未使用 IncludeAllContentForSelfExtract。）
  -->
  <Target Name="KeepIjwAssembliesOutOfBundle" AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
          Condition="'%(Filename)%(Extension)' == 'DirectWriteForwarder.dll' or '%(Filename)%(Extension)' == 'System.Printing.dll' or '%(Filename)%(Extension)' == 'ijwhost.dll'"
          ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

</Project>
