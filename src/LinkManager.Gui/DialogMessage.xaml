<Window x:Class="LinkManager.Gui.DialogMessage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Width="440" SizeToContent="Height" MaxWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FAFAFB"
        UseLayoutRounding="True"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Padding" Value="18,6" />
            <Setter Property="Background" Value="{StaticResource {x:Static SystemColors.HighlightBrushKey}}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 消息卡片：左色条 + 图标 + 标题 + 正文（颜色在 Loaded 时按种类上） -->
        <Border Grid.Row="0" x:Name="CardBorder" Background="#EFF6FF" BorderBrush="#BBD8F5"
                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Rectangle Grid.Column="0" x:Name="BarRect" Width="4" RadiusX="2" RadiusY="2"
                           Fill="#0067C0" Margin="0,0,12,0" />

                <TextBlock Grid.Column="1" x:Name="GlyphText" Text="ℹ" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Top" Margin="0,0,10,0" />

                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                               Margin="0,0,0,6" Text="提示" />
                    <TextBlock x:Name="DetailText" Foreground="#3B3B3F" FontSize="12.5" TextWrapping="Wrap"
                               Text="详情" />
                </StackPanel>
            </Grid>
        </Border>

        <Button Grid.Row="1" x:Name="OkButton" Content="知道了" Padding="18,6"
                HorizontalAlignment="Right" FontWeight="SemiBold" Click="OkButton_Click"
                Background="#0067C0" Foreground="White" BorderBrush="#0067C0" Cursor="Hand"
                IsDefault="True" IsCancel="True" />
    </Grid>
</Window>
