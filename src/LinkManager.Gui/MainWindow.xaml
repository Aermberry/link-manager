<Window x:Class="LinkManager.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="link-manager — 链接管理" Height="600" Width="1000" MinHeight="420" MinWidth="720"
        Icon="pack://application:,,,/app.ico"
        Background="#FAFAFB"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <!-- Fluent 浅色基础色板（Phase 1：先于框架升级手调，后续可换 WPF 主题库） -->
        <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1975C5" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#005BA1" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E0E0E3" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#5D5D63" />

        <!-- 顶部入口按钮：默认强调（迁移向导）/ 次级（其余） -->
        <Style x:Key="EntryButtonBase" TargetType="Button">
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryEntryButton" TargetType="Button" BasedOn="{StaticResource EntryButtonBase}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SecondaryEntryButton" TargetType="Button" BasedOn="{StaticResource EntryButtonBase}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1B1B1F" />
            <Setter Property="BorderBrush" Value="#C9C9CF" />
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏：四个入口，迁移向导为默认强调 -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E5E8" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="WizardButton" Style="{StaticResource PrimaryEntryButton}"
                        Content="迁移向导…" Click="WizardButton_Click" />
                <Button x:Name="CreateButton" Style="{StaticResource SecondaryEntryButton}"
                        Content="创建" Click="CreateButton_Click" />
                <Button x:Name="ScanButton" Style="{StaticResource SecondaryEntryButton}"
                        Content="扫描" Click="ScanButton_Click" />
                <Button x:Name="RefreshButton" Style="{StaticResource SecondaryEntryButton}"
                        Content="刷新健康检查" Click="RefreshButton_Click" />
            </StackPanel>
        </Border>

        <!-- 全宽登记列表（列表信息布局为列式） -->
        <Border Grid.Row="1" Margin="14,12,14,10" Background="Transparent">
            <ListView x:Name="EntriesList"
                      BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="状态" Width="86">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="链接位置（源）" Width="290" DisplayMemberBinding="{Binding Source}" />
                        <GridViewColumn Header="数据真实位置（目标）" Width="290" DisplayMemberBinding="{Binding Target}" />
                        <GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding Type}" />
                        <GridViewColumn Header="备注" Width="220" DisplayMemberBinding="{Binding Note}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <StatusBar Grid.Row="2" Background="#F3F3F6" BorderBrush="#E0E0E3" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
