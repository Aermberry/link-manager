<Window x:Class="LinkManager.Gui.CreateLinkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="创建 junction — 只建链接，不搬数据"
        Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="pack://application:,,,/app.ico"
        Background="#FAFAFB">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#5D5D63" />
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 创建-vs-向导分工说明（语义必须保留：创建不搬数据，搬家走向导） -->
        <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#BBD8F5" BorderThickness="1"
                CornerRadius="6" Padding="12,9" Margin="0,0,0,14">
            <TextBlock TextWrapping="Wrap" Foreground="#1E58A8" FontSize="12"
                       Text="数据已经搬到了新位置，只需要在原位置放一个链接？用这个表单直接创建，不搬任何数据。数据还在原地、要整个搬走 → 用「迁移向导」（复制 → 删源 → 回指一步到位）。" />
        </Border>

        <!-- 源 = 数据真实位置（bug #v1.0.6 实测修正：旧文案「链接处（源）」与实现语义相反） -->
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,4"
                   Text="数据真实位置（源）：数据现在实际待的目录。" />
        <TextBox Grid.Row="2" x:Name="SourcePathInput" Margin="0,0,0,12" />

        <TextBlock Grid.Row="3" TextWrapping="Wrap" Margin="0,0,0,4"
                   Text="链接位置（目标）：在这里创建指向源的链接（目录尚不存在或为空）。" />
        <TextBox Grid.Row="4" x:Name="TargetPathInput" Margin="0,0,0,12" />

        <TextBlock Grid.Row="5" Text="备注（可选）：" Margin="0,0,0,4" />
        <TextBox Grid.Row="6" x:Name="NoteInput" Margin="0,0,0,0" />

        <!-- 按钮行（v1.0.6 实测发现与备注同排 Grid.Row=6 重叠，本版理顺为第 7 行） -->
        <Grid Grid.Row="7" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" x:Name="CancelButton" Content="取消" Padding="16,6"
                    Margin="0,0,8,0" IsCancel="True" />
            <Button Grid.Column="2" x:Name="OkButton" Content="创建" Padding="16,6"
                    Background="{StaticResource AccentBrush}" Foreground="White"
                    FontWeight="SemiBold" Click="OkButton_Click" />
        </Grid>
    </Grid>
</Window>
