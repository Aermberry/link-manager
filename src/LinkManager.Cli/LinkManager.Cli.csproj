<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LinkManager.Core\LinkManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 退出码/参数解析约定的单元测试经 InternalsVisibleTo 钉死（CliArgParser/ExitCodes） -->
    <InternalsVisibleTo Include="LinkManager.Cli.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <!-- 本地构建默认版本；Release CI 打 tag 时用 -p:Version=<tag 去掉 v> 覆盖（见 .github/workflows/release.yml）。 -->
    <Version>1.1.0</Version>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    发布配置（agent 体验 / issue #20）：`dotnet publish -c Release` 直接产出
    自包含单文件 exe，无需装运行时，可拷走双击运行。发布产物在
    bin/Release/net11.0/win-x64/publish/。构建说明见 README 与 docs/cli-conventions.md。
    仅在 Release 下启用：Debug 内环保持框架依赖快速构建，不背自包含体积。
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
